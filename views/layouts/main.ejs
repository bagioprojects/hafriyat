<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('../components/seo/head', { seo }) %>
  <%- include('../components/seo/schema', { schemas: typeof schemas !== 'undefined' ? schemas : [] }) %>
</head>
<body class="site-body">
  <!-- Header -->
  <%- include('../components/common/header', { activeNav: typeof activeNav !== 'undefined' ? activeNav : '' }) %>

  <!-- Breadcrumbs -->
  <% if (typeof seo !== 'undefined' && seo.breadcrumbs && seo.breadcrumbs.length > 1) { %>
    <%- include('../components/seo/breadcrumbs', { items: seo.breadcrumbs }) %>
  <% } %>

  <!-- Main Content Body -->
  <main class="site-main" id="mainContent">
    <%- body %>
  </main>

  <!-- Sticky Quick Contact (WhatsApp & Phone) -->
  <%- include('../components/common/whatsappFloat') %>

  <!-- Footer -->
  <%- include('../components/common/footer') %>

  <!-- Mobile Sticky Bottom Action Bar (Hemen Ara & WhatsApp) -->
  <%- include('../components/common/mobileBottomNav') %>

  <!-- Gerçek Çerez ve Gizlilik Onay Modalı (KVKK & GDPR) -->
  <%- include('../components/common/cookieModal') %>

  <!-- Scripts (Defer ile Render Engelleyici Süre Sıfırlandı) -->
  <script src="/js/main.js?v=1.3.4" defer></script>
</body>
</html>

