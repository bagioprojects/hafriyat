<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>">
<% if (seo.keywords) { %>
<meta name="keywords" content="<%= seo.keywords %>">
<% } %>
<meta name="robots" content="<%= seo.robots %>">
<link rel="canonical" href="<%= seo.canonicalUrl %>">
<link rel="alternate" hreflang="tr" href="<%= seo.canonicalUrl %>">
<link rel="alternate" hreflang="x-default" href="<%= seo.canonicalUrl %>">
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
<meta name="theme-color" content="<%= seo.themeColor %>">
<meta name="author" content="Adem Hafriyat">
<meta name="publisher" content="Adem Hafriyat">
<meta name="language" content="Turkish">
<meta http-equiv="content-language" content="tr">

<!-- Coğrafi (GEO) & Yerel Arama Meta Etiketleri (Yalova / TR-77) -->
<meta name="geo.region" content="TR-77">
<meta name="geo.placename" content="Yalova, Çiftlikköy, Taşköprü">
<meta name="geo.position" content="40.6628;29.3512">
<meta name="ICBM" content="40.6628, 29.3512">
<meta name="DC.title" content="<%= seo.title %>">
<meta name="DC.creator" content="Adem Hafriyat">
<meta name="DC.subject" content="Yalova Kepçe Kiralama, Forklift Kiralama, Hafriyat">
<meta name="DC.coverage" content="Yalova, Çiftlikköy, Taşköprü, Altınova, Çınarcık, Armutlu, Termal">

<!-- Favicon & Mobil Uygulama İkonları -->
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="alternate icon" href="/images/favicon.svg">
<link rel="apple-touch-icon" href="/images/favicon.svg">

<!-- Open Graph / Facebook / WhatsApp Kartları -->
<meta property="og:type" content="<%= seo.ogType || 'website' %>">
<meta property="og:url" content="<%= seo.canonicalUrl %>">
<meta property="og:title" content="<%= seo.title %>">
<meta property="og:description" content="<%= seo.description %>">
<meta property="og:image" content="<%= seo.ogImage %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="tr_TR">
<meta property="og:site_name" content="Adem Hafriyat">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content="<%= seo.canonicalUrl %>">
<meta name="twitter:title" content="<%= seo.title %>">
<meta name="twitter:description" content="<%= seo.description %>">
<meta name="twitter:image" content="<%= seo.ogImage %>">

<!-- Hız Optimizasyonu: DNS Preconnect, Resource Preloads & Font Display Swap -->
<link rel="dns-prefetch" href="https://fonts.googleapis.com">
<link rel="dns-prefetch" href="https://fonts.gstatic.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<!-- Kritik Varlık Ön Yüklemeleri (LCP & First Paint) -->
<link rel="preload" href="/css/theme.css?v=1.3.3" as="style">
<link rel="preload" href="/css/main.css?v=1.3.3" as="style">
<link rel="preload" href="/images/logo.svg?v=1.3.4" as="image" type="image/svg+xml" fetchpriority="high">

<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Stil Dosyaları -->
<link rel="stylesheet" href="/css/theme.css?v=1.3.3">
<link rel="stylesheet" href="/css/main.css?v=1.3.3">
