<!-- Home Hero Section -->
<section class="home-hero">
  <div class="container hero-grid">
    <div class="hero-left">
      <div class="hero-badge-wrap">
        <span class="badge-amber">7/24 ACİL İŞ MAKİNESİ SERVİSİ</span>
      </div>
      <h1 class="home-hero-title">
        Yalova Kepçe Kiralama & <br class="desktop-only">
        <span class="text-amber">Operatörlü Forklift</span> Hizmetleri
      </h1>
      <p class="home-hero-desc">
        Adem Hafriyat güvencesiyle; <strong>Çiftlikköy, Taşköprü, Yalova Merkez ve tüm ilçelerde</strong> kanal kazma, temel hafriyatı, su kuyusu, arazi düzleme ve sanayi forklift kiralama. En geç <strong>15 dakikada sahada!</strong>
      </p>

      <div class="hero-highlights-list">
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>G Sınıfı Ehliyetli Uzman Operatörler</span>
        </div>
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>JCB 3CX Bekoloder & Mini Kepçe Filosu</span>
        </div>
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>3 - 5 Ton Sanayi Tipi Kiralık Forklift</span>
        </div>
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>Yalova Genelinde Hızlı Keşif &amp; Şeffaf Fiyat</span>
        </div>
      </div>

      <div class="hero-cta-group">
        <a href="tel:<%= siteConfig.phoneRaw %>" class="btn btn-hero-action btn-hero-call pulse-btn" aria-label="Hemen Arayın: <%= siteConfig.phone %>">
          <div class="btn-hero-icon-box">
            <svg class="btn-hero-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="btn-hero-content">
            <span class="btn-hero-badge">7/24 KESİNTİSİZ ÇAĞRI</span>
            <span class="btn-hero-title">Hemen Ara: <%= siteConfig.phone %></span>
          </div>
        </a>
        <a href="https://wa.me/<%= siteConfig.whatsapp %>?text=<%= encodeURIComponent(siteConfig.whatsappMessage) %>" class="btn btn-hero-action btn-hero-wa" target="_blank" rel="noopener" aria-label="WhatsApp ile Konum Gönder">
          <div class="btn-hero-icon-box">
            <svg class="btn-hero-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
          </div>
          <div class="btn-hero-content">
            <span class="btn-hero-badge">FİYAT &amp; KEŞİF ALIN</span>
            <span class="btn-hero-title">WhatsApp ile Konum Gönder</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Quick Quote Box -->
    <div class="hero-right">
      <%- include('../components/common/quickQuote') %>
    </div>
  </div>
</section>

<!-- Trust & Stats Strip (Otomatik Duyarlı Akışkan Tipografi) -->
<section class="stats-strip-section">
  <div class="container stats-strip-grid">
    <div class="stat-item">
      <div class="stat-number">14+ Yıl</div>
      <div class="stat-label">Yalova Saha Tecrübesi</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">15 Dk</div>
      <div class="stat-label">Çiftlikköy &amp; Taşköprü Varış</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">%100</div>
      <div class="stat-label">G Sınıfı Belgeli Operatör</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">7 / 24</div>
      <div class="stat-label">Kesintisiz Acil Müdahale</div>
    </div>
  </div>
</section>

<!-- Services Grid Section -->
<section class="service-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">UZMANLIK ALANLARIMIZ</span>
      <h2 class="section-title">Yalova Kepçe ve Forklift Hizmetlerimiz</h2>
      <p class="section-subtitle">
        Tüm ilçelerde kanal kazmadan temel açmaya, su kuyusundan fabrika forklift kiralama işlerine kadar eksiksiz çözümler.
      </p>
    </div>

    <%- include('../components/services/serviceGrid', { services }) %>
  </div>
</section>

<!-- Districts / Geo Selector Section -->
<%- include('../components/geo/districtSelector', { districts }) %>

<!-- Machinery Fleet Section -->
<section class="machinery-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">GÜÇLÜ MAKİNE PARKURU</span>
      <h2 class="section-title">Kiralık Kepçe & Forklift Filomuz</h2>
      <p class="section-subtitle">
        Periyodik bakımları eksiksiz yapılmış, iş güvenliği onaylı son model iş makinelerimizle hizmetinizdeyiz.
      </p>
    </div>

    <div class="machine-grid">
      <% machinery.slice(0, 4).forEach(machine => { %>
        <%- include('../components/machinery/machineCard', { machine }) %>
      <% }); %>
    </div>
    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/makinelerimiz" class="btn btn-dark-outline btn-lg">Tüm Makine Parkurunu İncele &rarr;</a>
    </div>
  </div>
</section>

<!-- Work Process Section (Kurumsal RAL 7016 Antrasit Zemin) -->
<section style="background-color: var(--color-dark); color: #ffffff; padding: 4.5rem 0; border-top: 4px solid var(--color-primary);">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">NASIL ÇALIŞIYORUZ?</span>
      <h2 class="section-title" style="color: #ffffff;">4 Adımda İş Teslimi</h2>
      <p class="section-subtitle" style="color: #cbd5e1;">
        Adem Hafriyat ile çalışırken sürprizlerle karşılaşmazsınız; şeffaf ve profesyonel süreç yönetimi.
      </p>
    </div>

    <div class="process-step-grid">
      <div class="process-step-card">
        <span class="process-step-num">01</span>
        <h3 class="process-step-title">İletişim &amp; Hızlı Keşif</h3>
        <p class="process-step-desc">
          Bizi arayarak veya WhatsApp ile konum göndererek ihtiyacınızı belirtin. Mesafe ve zemin durumuna göre en uygun maliyetle yerinde keşif ve net fiyatlandırma yapalım.
        </p>
      </div>

      <div class="process-step-card">
        <span class="process-step-num">02</span>
        <h3 class="process-step-title">Doğru Makine &amp; Şeffaf Fiyat</h3>
        <p class="process-step-desc">
          İşin zemin ve kot durumuna en uygun makineyi (bekoloder, mini kepçe veya forklift) belirleyip net fiyat teklifimizi sunalım.
        </p>
      </div>

      <div class="process-step-card">
        <span class="process-step-num">03</span>
        <h3 class="process-step-title">Hızlı Sevk &amp; Uzman Operatör</h3>
        <p class="process-step-desc">
          Çiftlikköy / Taşköprü garajımızdan makinemiz ve G sınıfı belgeli operatörümüz belirlenen saatte şantiyenizde hazır olsun.
        </p>
      </div>

      <div class="process-step-card">
        <span class="process-step-num">04</span>
        <h3 class="process-step-title">Kusursuz Teslimat &amp; Onay</h3>
        <p class="process-step-desc">
          Lazer nivo ve kot kontrolü ile sıfır sapmayla kazı veya yüklemeyi tamamlayıp sahanızı temiz biçimde teslim edelim.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Blog / Makaleler Highlights -->
<section class="blog-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">BİLGİ MERKEZİ & REHBER</span>
      <h2 class="section-title">Hafriyat ve İş Makinesi Makaleleri</h2>
      <p class="section-subtitle">
        Gerçek saha tecrübesiyle hazırlanmış uzman şantiye, zemin ve kiralama rehberleri.
      </p>
    </div>

    <div class="blog-grid">
      <% blogPosts.forEach(post => { %>
        <%- include('../components/content/blogCard', { post }) %>
      <% }); %>
    </div>
    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/makaleler" class="btn btn-dark-outline btn-lg">Tüm Makaleleri Oku &rarr;</a>
    </div>
  </div>
</section>

<!-- SSS / FAQ Section -->
<%- include('../components/content/faqAccordion', { faqs }) %>

<!-- CTA Banner -->
<%- include('../components/common/ctaBanner', {
  title: 'Yalova’da Kepçe veya Forklift Kiralamak İçin Hemen Arayın!',
  description: 'Adem Hafriyat olarak Çiftlikköy, Taşköprü, Yalova Merkez ve tüm ilçelerde 15 dakikada en uygun fiyatla yanınızdayız.'
}) %>

