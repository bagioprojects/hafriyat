          <li><a href="/site-haritasi" class="mobile-nav-link">Site Haritası</a></li>
          <li><a href="/hakkimizda" class="mobile-nav-link">Hakkımızda</a></li>
          <li><a href="/iletisim" class="mobile-nav-link">İletişim &amp; Adres</a></li>
        </ul>
      </nav>
    </div>

    <div class="mobile-drawer-footer">
      <a href="tel:<%= siteConfig.phoneRaw %>" class="btn btn-hero-action btn-hero-call pulse-btn" style="width: 100%; margin-bottom: 0.65rem;">
        <div class="btn-hero-icon-box">
          <svg class="btn-hero-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
