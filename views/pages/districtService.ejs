<%- include('../components/common/pageHero', {
  title: crossTitle,
  subtitle: `${district.name} genelinde, tüm mahalle ve köylerinde profesyonel ${service.title.toLowerCase()}. Adem Hafriyat güvencesiyle 15 dakikada adreste!`,
  badge: `📍 ${district.name.toUpperCase()} ÖZEL HİZMETİ`
}) %>

<div class="container page-content-wrap">
  <div class="content-sidebar-layout">
    <!-- Sol İçerik -->
    <div>
      <div style="background-color: #ffffff; border: 1px solid var(--color-border-light); border-left: 5px solid var(--color-primary); padding: 1.75rem; border-radius: var(--radius-sm); margin-bottom: 2.5rem;">
        <h3 style="font-size: 1.3rem; margin-bottom: 1rem; color: var(--color-dark);">
          <%= district.name %> Bölgesinde <%= service.shortTitle || service.title %> Ayrıcalıkları
        </h3>
        <p style="font-size: var(--text-sm); line-height: 1.7; color: var(--color-text-main); margin-bottom: 1rem;">
          <%= district.name %> zemin ve coğrafi koşullarına tam uyumlu iş makinelerimiz, teleskopik bomlu JCB bekoloderlerimiz ve dar sokak kauçuk paletli mini kepçelerimizle hizmetinizdeyiz. 
          Garajımızdan <%= district.name %> sınırlarına intikal süremiz ortalama <strong><%= district.responseMinutes %> dakikadır</strong>.
        </p>
        <ul style="display: flex; flex-direction: column; gap: 0.65rem;">
          <% service.features.slice(0, 4).forEach(f => { %>
            <li style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: var(--text-sm);">
              <span style="color: var(--color-primary-dark); font-weight: 900;">✓</span>
              <span><%= f %></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <!-- Mahalle ve Köy SEO Listesi -->
      <%- include('../components/geo/neighborhoodGrid', { district }) %>

      <!-- Detaylı İçerik Bloğu -->
      <div class="prose-content" style="margin-top: 2.5rem;">
        <h3><%= district.name %> İçin <%= service.shortTitle || service.title %> Nasıl Gerçekleştirilir?</h3>
        <p>
          Adem Hafriyat olarak, <%= district.name %> sınırları içerisindeki konut, sanayi veya tarım sahalarında yapılacak 
          <strong><%= service.title.toLowerCase() %></strong> çalışmalarında öncelikle yer altı altyapı hatlarının (su boruları, fiber kablolar, doğalgaz hatları) keşfini yapıyoruz. 
          Lazer nivo teknolojisi ile kazı veya zemin tesviyesinde sıfır hata prensibiyle çalışıyoruz.
        </p>
        <%- service.content.replace(/\n\n/g, '<br><br>').replace(/### (.*?)\n/g, '<h3>$1</h3>').replace(/#### (.*?)\n/g, '<h4>$1</h4>') %>
      </div>

      <!-- Sıkça Sorulan Sorular -->
      <% if (localServiceFaqs && localServiceFaqs.length > 0) { %>
        <div style="margin-top: 3.5rem;">
          <%- include('../components/content/faqAccordion', { faqs: localServiceFaqs }) %>
        </div>
      <% } %>
    </div>

    <!-- Sağ Sidebar -->
    <aside style="display: flex; flex-direction: column; gap: 2rem;">
      <%- include('../components/common/quickQuote') %>

      <!-- Hızlı İletişim -->
      <div style="background-color: var(--color-dark); color: #ffffff; padding: 2rem; border-radius: var(--radius-sm); border-top: 4px solid var(--color-primary); text-align: center;">
        <span style="font-size: var(--text-xs); color: var(--color-primary); font-weight: 800; display: block; margin-bottom: 0.5rem;">
          <%= district.name.toUpperCase() %> ACİL ÇAĞRI
        </span>
        <h3 style="font-size: 1.5rem; color: #ffffff; margin-bottom: 0.5rem;">Anında Keşif & Fiyat</h3>
        <p style="font-size: var(--text-xs); color: #94a3b8; margin-bottom: 1.5rem;">
          Operatörümüzle hemen görüşün, <%= district.responseMinutes %> dakikada şantiyenizde olalım.
        </p>
        <a href="tel:<%= siteConfig.phoneRaw %>" class="btn btn-primary btn-block btn-lg pulse-btn">
          <%= siteConfig.phone %>
        </a>
      </div>

      <!-- Bu Bölgede Diğer Hizmetler -->
      <div style="background-color: #ffffff; border: 1px solid var(--color-border-light); padding: 1.5rem; border-radius: var(--radius-sm);">
        <h4 style="font-size: 1.15rem; margin-bottom: 1rem; color: var(--color-dark); border-bottom: 2px solid var(--color-primary); padding-bottom: 0.4rem;">
          <%= district.name %> Diğer Hizmetler
        </h4>
        <ul style="display: flex; flex-direction: column; gap: 0.65rem;">
          <% otherServices.forEach(os => { %>
            <li>
              <a href="/bolgeler/<%= district.slug %>/<%= os.slug %>" style="font-size: var(--text-sm); font-weight: 600; color: var(--color-dark); display: flex; justify-content: space-between;">
                <span><%= os.title %></span>
                <span style="color: var(--color-primary-dark);">&rarr;</span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    </aside>
  </div>
</div>

<!-- CTA Banner -->
<%- include('../components/common/ctaBanner', {
  title: `${district.name} ${service.shortTitle || service.title} İçin Hemen Arayın`,
  description: 'Adem Hafriyat en uygun fiyat ve uzman operatör garantisiyle 7/24 hizmetinizdedir.'
}) %>

