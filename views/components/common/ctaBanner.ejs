<section class="cta-banner">
  <div class="container cta-flex">
    <div class="cta-text">
      <span class="cta-badge">YALOVA & TÜM İLÇELERİ</span>
      <h2 class="cta-title"><%= typeof title !== 'undefined' ? title : 'Kepçe veya Forklift İhtiyacınız mı Var?' %></h2>
      <p class="cta-desc">
        <%= typeof description !== 'undefined' ? description : 'Çiftlikköy ve Taşköprü garajımızdan en geç 15-20 dakika içinde uzman operatörümüz ve iş makinemiz adresinizde olsun.' %>
      </p>
    </div>
    <div class="cta-buttons">
      <a href="tel:<%= siteConfig.phoneRaw %>" class="btn btn-primary btn-lg pulse-btn">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <%= siteConfig.phone %>
      </a>
      <a href="https://wa.me/<%= siteConfig.whatsapp %>" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
        WhatsApp ile Hızlı Keşif
      </a>
    </div>
  </div>
</section>

