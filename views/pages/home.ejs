<!-- Home Hero Section -->
<section class="home-hero">
  <div class="container hero-grid">
    <div class="hero-left">
      <div class="hero-badge-wrap">
        <span class="badge-amber">7/24 ACİL İŞ MAKİNESİ SERVİSİ</span>
      </div>
      <h1 class="home-hero-title">
        Yalova Kepçe Kiralama & <br>
        <span class="text-amber">Operatörlü Forklift</span> Hizmetleri
      </h1>
      <p class="home-hero-desc">
        Adem Hafriyat güvencesiyle; <strong>Çiftlikköy, Taşköprü, Yalova Merkez ve tüm ilçelerde</strong> kanal kazma, temel hafriyatı, su kuyusu, arazi düzleme ve sanayi forklift kiralama. En geç <strong>15 dakikada sahada!</strong>
      </p>

      <div class="hero-highlights-list">
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>G Sınıfı Ehliyetli Uzman Operatörler</span>
        </div>
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>JCB 3CX Bekoloder & Mini Kepçe Filosu</span>
        </div>
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>3 - 5 Ton Sanayi Tipi Kiralık Forklift</span>
        </div>
        <div class="hero-highlight-item">
          <span class="check-amber">✓</span>
          <span>Yalova Genelinde Ücretsiz Keşif İmkânı</span>
        </div>
      </div>

      <div class="hero-cta-group">
        <a href="tel:<%= siteConfig.phoneRaw %>" class="btn btn-primary btn-lg pulse-btn">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Hemen Ara: <%= siteConfig.phone %>
        </a>
        <a href="https://wa.me/<%= siteConfig.whatsapp %>" class="btn btn-dark-outline btn-lg" target="_blank" rel="noopener">
          WhatsApp ile Konum Atın
        </a>
      </div>
    </div>

    <!-- Quick Quote Box -->
    <div class="hero-right">
      <%- include('../components/common/quickQuote') %>
    </div>
  </div>
</section>

<!-- Trust & Stats Strip -->
<section style="background-color: #ffffff; padding: 2rem 0; border-bottom: 1px solid var(--color-border-light);">
  <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; text-align: center;">
    <div>
      <div style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 900; color: var(--color-primary-dark);">14+ Yıl</div>
      <div style="font-size: var(--text-sm); color: var(--color-text-muted);">Yalova Saha Tecrübesi</div>
    </div>
    <div>
      <div style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 900; color: var(--color-primary-dark);">15 Dk</div>
      <div style="font-size: var(--text-sm); color: var(--color-text-muted);">Çiftlikköy & Taşköprü Varış</div>
    </div>
    <div>
      <div style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 900; color: var(--color-primary-dark);">%100</div>
      <div style="font-size: var(--text-sm); color: var(--color-text-muted);">G Sınıfı Belgeli Operatör</div>
    </div>
    <div>
      <div style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 900; color: var(--color-primary-dark);">7 / 24</div>
      <div style="font-size: var(--text-sm); color: var(--color-text-muted);">Kesintisiz Acil Müdahale</div>
    </div>
  </div>
</section>

<!-- Services Grid Section -->
<section class="service-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">UZMANLIK ALANLARIMIZ</span>
      <h2 class="section-title">Yalova Kepçe ve Forklift Hizmetlerimiz</h2>
      <p class="section-subtitle">
        Tüm ilçelerde kanal kazmadan temel açmaya, su kuyusundan fabrika forklift kiralama işlerine kadar eksiksiz çözümler.
      </p>
    </div>

    <%- include('../components/services/serviceGrid', { services }) %>
  </div>
</section>

<!-- Interactive Cost & Machinery Calculator Section -->
<%- include('../components/common/costCalculator') %>

<!-- Districts / Geo Selector Section -->
<%- include('../components/geo/districtSelector', { districts }) %>

<!-- Machinery Fleet Section -->
<section class="machinery-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">GÜÇLÜ MAKİNE PARKURU</span>
      <h2 class="section-title">Kiralık Kepçe & Forklift Filomuz</h2>
      <p class="section-subtitle">
        Periyodik bakımları eksiksiz yapılmış, iş güvenliği onaylı son model iş makinelerimizle hizmetinizdeyiz.
      </p>
    </div>

    <div class="machine-grid">
      <% machinery.slice(0, 4).forEach(machine => { %>
        <%- include('../components/machinery/machineCard', { machine }) %>
      <% }); %>
    </div>
    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/makinelerimiz" class="btn btn-dark-outline btn-lg">Tüm Makine Parkurunu İncele &rarr;</a>
    </div>
  </div>
</section>

<!-- Work Process Section -->
<section style="background-color: #0b0f19; color: #ffffff; padding: 4.5rem 0; border-top: 4px solid var(--color-primary);">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">NASIL ÇALIŞIYORUZ?</span>
      <h2 class="section-title" style="color: #ffffff;">4 Adımda İş Teslimi</h2>
      <p class="section-subtitle" style="color: #94a3b8;">
        Adem Hafriyat ile çalışırken sürprizlerle karşılaşmazsınız; şeffaf ve profesyonel süreç yönetimi.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.75rem; margin-top: 2rem;">
      <div style="background-color: #1e293b; padding: 2rem; border-radius: var(--radius-sm); border-top: 3px solid var(--color-primary);">
        <span style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--color-primary); display: block; margin-bottom: 0.5rem;">01</span>
        <h3 style="color: #ffffff; font-size: 1.25rem; margin-bottom: 0.5rem;">İletişim & Ücretsiz Keşif</h3>
        <p style="font-size: var(--text-sm); color: #cbd5e1; line-height: 1.6;">
          Bizi arayarak veya WhatsApp ile konum göndererek ihtiyacınızı belirtin. Gerekli durumlarda sahada ücretsiz keşif yapalım.
        </p>
      </div>

      <div style="background-color: #1e293b; padding: 2rem; border-radius: var(--radius-sm); border-top: 3px solid var(--color-primary);">
        <span style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--color-primary); display: block; margin-bottom: 0.5rem;">02</span>
        <h3 style="color: #ffffff; font-size: 1.25rem; margin-bottom: 0.5rem;">Doğru Makine & Şeffaf Fiyat</h3>
        <p style="font-size: var(--text-sm); color: #cbd5e1; line-height: 1.6;">
          İşin zemin ve kot durumuna en uygun makineyi (bekoloder, mini kepçe veya forklift) belirleyip net fiyat teklifimizi sunalım.
        </p>
      </div>

      <div style="background-color: #1e293b; padding: 2rem; border-radius: var(--radius-sm); border-top: 3px solid var(--color-primary);">
        <span style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--color-primary); display: block; margin-bottom: 0.5rem;">03</span>
        <h3 style="color: #ffffff; font-size: 1.25rem; margin-bottom: 0.5rem;">Hızlı Sevk & Uzman Operatör</h3>
        <p style="font-size: var(--text-sm); color: #cbd5e1; line-height: 1.6;">
          Çiftlikköy / Taşköprü garajımızdan makinemiz ve G sınıfı belgeli operatörümüz belirlenen saatte şantiyenizde hazır olsun.
        </p>
      </div>

      <div style="background-color: #1e293b; padding: 2rem; border-radius: var(--radius-sm); border-top: 3px solid var(--color-primary);">
        <span style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--color-primary); display: block; margin-bottom: 0.5rem;">04</span>
        <h3 style="color: #ffffff; font-size: 1.25rem; margin-bottom: 0.5rem;">Kusursuz Teslimat & Onay</h3>
        <p style="font-size: var(--text-sm); color: #cbd5e1; line-height: 1.6;">
          Lazer nivo ve kot kontrolü ile sıfır sapmayla kazı veya yüklemeyi tamamlayıp sahanızı temiz biçimde teslim edelim.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Blog / Makaleler Highlights -->
<section class="blog-section">
  <div class="container">
    <div class="section-header-centered">
      <span class="badge-amber">BİLGİ MERKEZİ & REHBER</span>
      <h2 class="section-title">Hafriyat ve İş Makinesi Makaleleri</h2>
      <p class="section-subtitle">
        Gerçek saha tecrübesiyle hazırlanmış uzman şantiye, zemin ve kiralama rehberleri.
      </p>
    </div>

    <div class="blog-grid">
      <% blogPosts.forEach(post => { %>
        <%- include('../components/content/blogCard', { post }) %>
      <% }); %>
    </div>
    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/makaleler" class="btn btn-dark-outline btn-lg">Tüm Makaleleri Oku &rarr;</a>
    </div>
  </div>
</section>

<!-- SSS / FAQ Section -->
<%- include('../components/content/faqAccordion', { faqs }) %>

<!-- CTA Banner -->
<%- include('../components/common/ctaBanner', {
  title: 'Yalova’da Kepçe veya Forklift Kiralamak İçin Hemen Arayın!',
  description: 'Adem Hafriyat olarak Çiftlikköy, Taşköprü, Yalova Merkez ve tüm ilçelerde 15 dakikada en uygun fiyatla yanınızdayız.'
}) %>

