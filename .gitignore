# ==============================================================================
# Production .gitignore — Adem Hafriyat (yalovakepcehafriyat.com.tr)
# ==============================================================================

# Bağımlılıklar
node_modules/
package-lock.json.bak

# Ortam ve Gizli Anahtarlar (Production Secret Security)
.env
.env.*
!.env.example

# Loglar ve Geçici Çalışma Dosyaları
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# PM2 ve Süreç Yöneticisi Çıktıları
.pm2/
pm2.log

# İşletim Sistemi ve Dosya Sistemi İzleri
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editör ve IDE Yapılandırmaları
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test Kapsamı ve Geçici Çıktılar
coverage/
.nyc_output/
scripts/temp*
scripts/scratch*

# Antigravity & Agent Çalışma Dosyaları
.gemini/
.system_generated/
