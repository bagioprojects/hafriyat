# ==============================================================================
# Adem Hafriyat — Canlı Sunucu (Production) Çevresel Değişken Şablonu
# Bu dosyayı canlı sunucuda '.env' olarak kopyalayınız: cp .env.example .env
# ==============================================================================

# Çalışma Ortamı (production / development / test)
NODE_ENV=production

# Dinlenecek Yerel Port (Nginx ters proxy arkasında varsayılan: 7450)
PORT=7450

# Canlı Domain ve SSL Temel URL'i (Sonda eğik çizgi olmadan)
SITE_URL=https://yalovakepcehafriyat.com.tr

# Kurumsal İletişim Bilgileri
COMPANY_PHONE=0532 720 20 10
COMPANY_EMAIL=info@yalovakepcehafriyat.com.tr
COMPANY_WHATSAPP=905327202010
