<div class="calculator-container" id="fiyat-hesaplama">
  <div class="calculator-card">
    <div class="calculator-header">
      <span class="badge-amber">İNTERAKTİF MALİYET VE MAKİNE HESAPLAYICI</span>
      <h2 class="calc-title">Hafriyat & Kiralama İhtiyacınızı Hesaplayın</h2>
      <p class="calc-subtitle">
        Projenizin türünü ve yaklaşık metrajını girin; size en uygun makineyi, tahmini süreyi ve bütçeyi anında görelim.
      </p>
    </div>

    <form class="calc-form" id="costCalculatorForm" onsubmit="calculateCost(event)">
      <div class="calc-grid">
        <!-- 1. Hizmet Seçimi -->
        <div class="form-group">
          <label for="calcService">Yapılacak İş / Hizmet Türü:</label>
          <select id="calcService" class="form-control" onchange="updateCalcFields()">
            <option value="kanal">Kanal Kazma (Su, Elektrik, Drenaj vb.)</option>
            <option value="temel">Temel Kazma (Bina, Villa, Havuz)</option>
            <option value="duzleme">Arazi Düzleme & Tesviye (Tarla/Arsa)</option>
            <option value="micir">Dolgu ve Mıcır Yayma / Serme</option>
            <option value="forklift_saat">Forklift Kiralama (Saatlik Tır İndirme)</option>
            <option value="forklift_gun">Forklift Kiralama (Günlük / Aylık)</option>
            <option value="kepce_gun">Kepçe Kiralama (Saatlik / Günlük)</option>
          </select>
        </div>

        <!-- 2. İlçe Seçimi -->
        <div class="form-group">
          <label for="calcDistrict">Hizmet Bölgesi / İlçe:</label>
          <select id="calcDistrict" class="form-control">
            <option value="Çiftlikköy">Çiftlikköy (15 dk Servis)</option>
            <option value="Taşköprü">Taşköprü Sanayi (10 dk Servis)</option>
            <option value="Yalova Merkez">Yalova Merkez (20 dk Servis)</option>
            <option value="Altınova">Altınova / Tersaneler (25 dk Servis)</option>
            <option value="Çınarcık">Çınarcık & Koru (30 dk Servis)</option>
            <option value="Termal">Termal (25 dk Servis)</option>
            <option value="Armutlu">Armutlu (45 dk Servis)</option>
          </select>
        </div>

        <!-- 3. Zemin Türü -->
        <div class="form-group">
          <label for="calcGround">Zemin Yapısı:</label>
          <select id="calcGround" class="form-control">
            <option value="normal">Normal Toprak / Bahçe Zemini</option>
            <option value="kil">Sert Killi Zemin</option>
            <option value="tas">Kayalık / Kırıcı Ataşmanı Gerekli</option>
            <option value="sahil">Sahil Dolgu / Yüksek Taban Suyu</option>
          </select>
        </div>

        <!-- 4. Değişken Metraj / Miktar Alanı -->
        <div class="form-group">
          <label for="calcAmount" id="calcAmountLabel">Yaklaşık Metraj (Metre Tül):</label>
          <input type="number" id="calcAmount" class="form-control" value="50" min="1" max="10000" required>
        </div>
      </div>

      <div class="calc-action-row">
        <button type="submit" class="btn btn-primary btn-lg">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          Maliyeti & En Uygun Makineyi Hesapla
        </button>
      </div>
    </form>

    <!-- Hesaplama Sonuç Paneli -->
    <div class="calc-result-box" id="calcResultBox" style="display: none;">
      <div class="result-header">
        <span class="result-badge">HESAPLAMA ÖZETİ</span>
        <h3 class="result-title">Tavsiye Edilen Makine & Çözüm</h3>
      </div>
      <div class="result-grid">
        <div class="result-item">
          <span class="item-label">Önerilen İş Makinesi:</span>
          <strong class="item-value text-amber" id="resMachine">JCB 3CX Bekoloder</strong>
        </div>
        <div class="result-item">
          <span class="item-label">Tahmini Süre:</span>
          <strong class="item-value" id="resDuration">Yaklaşık 3 - 5 Saat</strong>
        </div>
        <div class="result-item">
          <span class="item-label">Gereken Ataşman:</span>
          <strong class="item-value" id="resAttachment">40 cm Dar Kanal Kovası</strong>
        </div>
        <div class="result-item">
          <span class="item-label">Bölge Varış Süresi:</span>
          <strong class="item-value" id="resResponse">15 Dakika</strong>
        </div>
      </div>

      <div class="result-cta">
        <p class="result-note">
          * Kesin ve bağlayıcı fiyat için sahada ücretsiz keşif yapıyoruz. Bu hesaplama ön bütçeleme amaçlıdır.
        </p>
        <div class="result-buttons">
          <a href="#" id="resWhatsappBtn" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
            WhatsApp ile Bu Hesabı Gönder & Teklif Al
          </a>
          <a href="tel:<%= siteConfig.phoneRaw %>" class="btn btn-primary btn-lg pulse-btn">
            Telefonla Hemen Onayla: <%= siteConfig.phone %>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
