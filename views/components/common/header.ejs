          <li><a href="/hizmetlerimiz/arazi-duzleme-tesviye" class="mobile-nav-link">Arazi Düzleme &amp; Tesviye</a></li>
          <li><a href="/hizmetlerimiz/dolgu-micir-yayma" class="mobile-nav-link">Dolgu &amp; Mıcır Yayma</a></li>
          <li><a href="/hizmetlerimiz" class="mobile-nav-link" style="color: var(--color-primary-dark); font-weight: 800;">&rarr; Tüm Hizmetler (10+ Alan)</a></li>

          <li class="mobile-nav-group-title">🏗️ FORKLİFT KİRALAMA</li>
          <li><a href="/hizmetlerimiz/forklift-kiralama" class="mobile-nav-link highlight"><strong>Yalova Forklift Kiralama</strong></a></li>
          <li><a href="/bolgeler/taskopru/mahalle/taskopru-sanayi" class="mobile-nav-link">Taşköprü Sanayi Forklift</a></li>
          <li><a href="/bolgeler/altinova/mahalle/altinova-tersaneler" class="mobile-nav-link">Altınova Tersaneler Forklift</a></li>

          <li class="mobile-nav-group-title">📍 HİZMET BÖLGELERİMİZ</li>
          <li><a href="/bolgeler/ciftlikkoy" class="mobile-nav-link">Çiftlikköy (Merkez, Sahil, 7 Köy)</a></li>
          <li><a href="/bolgeler/taskopru" class="mobile-nav-link">Taşköprü (Sanayi &amp; Fabrikalar)</a></li>
          <li><a href="/bolgeler/yalova-merkez" class="mobile-nav-link">Yalova Merkez (Tüm Mahalle &amp; Köyler)</a></li>
          <li><a href="/bolgeler/altinova" class="mobile-nav-link">Altınova</a></li>
          <li><a href="/bolgeler/cinarcik" class="mobile-nav-link">Çınarcık</a></li>
          <li><a href="/bolgeler/termal" class="mobile-nav-link">Termal &amp; Armutlu</a></li>

