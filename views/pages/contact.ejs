<%- include('../components/common/pageHero', {
  title: 'İletişim & Ücretsiz Keşif Hattı',
  subtitle: 'Yalova Kepçe ve Forklift Kiralama ihtiyaçlarınız için 7 gün 24 saat kesintisiz hizmetinizdeyiz.',
  badge: '7/24 DİREKT HAT'
}) %>

<div class="container" style="padding: 3rem 1.5rem;">
  <div class="contact-layout">
    <!-- Sol: İletişim Bilgileri & Garaj Adresi -->
    <div>
      <span class="badge-amber">MERKEZ GARAJ & OFİS</span>
      <h2 style="font-size: 2rem; margin: 0.5rem 0 1.5rem; color: var(--color-dark);">Adem Hafriyat İletişim Bilgileri</h2>

      <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2.5rem;">
        <div style="display: flex; gap: 1rem; align-items: flex-start; background-color: #ffffff; padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);">
          <div style="width: 44px; height: 44px; background-color: var(--color-dark); color: var(--color-primary); display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); font-size: 1.25rem; flex-shrink: 0;">
            📞
          </div>
          <div>
            <strong style="display: block; font-size: 0.85rem; color: var(--color-text-muted);">7/24 Acil Çağrı & Keşif:</strong>
            <a href="tel:<%= siteConfig.phoneRaw %>" style="font-size: 1.4rem; font-weight: 800; color: var(--color-dark); font-family: var(--font-heading);"><%= siteConfig.phone %></a>
            <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.25rem;">Gece ve gündüz tüm acil arıza ve hafriyat çağrılarına yanıt verilir.</p>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start; background-color: #ffffff; padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);">
          <div style="width: 44px; height: 44px; background-color: var(--color-accent-whatsapp); color: #ffffff; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); font-size: 1.25rem; flex-shrink: 0;">
            💬
          </div>
          <div>
            <strong style="display: block; font-size: 0.85rem; color: var(--color-text-muted);">WhatsApp Hızlı Destek &amp; Keşif:</strong>
            <a href="https://wa.me/<%= siteConfig.whatsapp %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm" style="margin-top: 0.35rem; display: inline-flex;">
              <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
              WhatsApp ile Konum Gönder
            </a>
            <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.35rem;">Şantiye fotoğrafınızı veya konumunuzu atarak 2 dakikada fiyat alın.</p>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start; background-color: #ffffff; padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border-light);">
          <div style="width: 44px; height: 44px; background-color: var(--color-dark); color: var(--color-primary); display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); font-size: 1.25rem; flex-shrink: 0;">
            📍
          </div>
          <div>
            <strong style="display: block; font-size: 0.85rem; color: var(--color-text-muted);">Merkez Makine Garajı:</strong>
            <span style="font-size: 1.05rem; font-weight: 600; color: var(--color-dark);"><%= siteConfig.address.streetAddress %></span>
            <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.25rem;"><%= siteConfig.address.addressLocality %> / <%= siteConfig.address.addressRegion %> (Taşköprü Sanayi Girişi)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sağ: Hızlı Keşif Formu -->
    <div>
      <%- include('../components/common/quickQuote') %>
    </div>
  </div>
</div>

<!-- District Selector -->
<%- include('../components/geo/districtSelector', { districts }) %>

