      <a href="https://wa.me/<%= siteConfig.whatsapp %>?text=<%= encodeURIComponent(siteConfig.whatsappMessage) %>" class="btn btn-hero-action btn-hero-wa" target="_blank" rel="noopener" style="width: 100%;">
